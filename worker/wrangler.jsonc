// Phase 1 staging Worker (doc 11 §7). It serves the built frontend as static
// assets and runs the API under /api/*. The public demo keeps its own config in
// frontend/wrangler.jsonc and is not touched by this file.
//
// The top level is local development. `--env staging` is the only deployable
// environment. Database ids are placeholders until the owner provisions them;
// scripts/staging-guard.mjs refuses to deploy while they are.
// Secrets (never in this file): CLERK_JWT_KEY, CLERK_SECRET_KEY, UNSUBSCRIBE_SIGNING_KEY,
// and OPENROUTER_API_KEY (Phase 3; optional: without it the Director says it's unavailable).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fan-director-studio-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Unsubscribe tokens travel in URLs; keep request logs off.
  "observability": { "enabled": false },
  "secrets": { "required": ["CLERK_JWT_KEY", "CLERK_SECRET_KEY", "UNSUBSCRIBE_SIGNING_KEY"] },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fan-director-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Creator uploads (migration 0005). Locally Wrangler simulates this bucket.
  // Bindings aren't inherited, so env.staging names its own (R2 enabled on the
  // Blendly account 2026-10-01). An environment with no binding answers uploads
  // with 503 media_storage_unavailable and still saves the rest of the lookbook.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "fan-director-media-development" }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "CLERK_ISSUER": "https://superb-crawdad-9550.clerk.accounts.dev",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:8787,http://localhost:5173",
    "AI_ENABLED": "false",
    "ADULT_CATALOG_ENABLED": "false",
    // Required here, so the test suite and local development exercise the rule.
    // Only staging waives it, deliberately (doc 11 §5.6 item 27).
    "CREATOR_SECOND_FACTOR_REQUIRED": "true"
  },
  "env": {
    "staging": {
      "name": "fan-director-studio-staging",
      // Stays true: the owner chose to keep the old hostname alive (2026-09-20).
      // It answers, and `canonicalRedirect` in src/http.ts sends it to
      // APP_ORIGIN, so every doc and bookmark still lands somewhere real.
      "workers_dev": true,
      "preview_urls": false,
      // ---------------------------------------------------------------------
      // CUSTOM DOMAIN — NOT YET ACTIVE. studiolens.me is registered but is not
      // a zone on this Cloudflare account (checked 2026-09-20: the account has
      // zero zones). Deploying with the block below while that is true FAILS.
      //
      // The whole cutover, once the zone is added and its nameservers resolve:
      //   1. uncomment "routes" below,
      //   2. change APP_ORIGIN to https://www.studiolens.me,
      //   3. npm run build --prefix frontend, then deploy env staging.
      // The apex is listed so studiolens.me resolves; canonicalRedirect sends
      // it to www, so no separate redirect rule is needed.
      //
      // "routes": [
      //   { "pattern": "www.studiolens.me", "custom_domain": true },
      //   { "pattern": "studiolens.me", "custom_domain": true }
      // ],
      // ---------------------------------------------------------------------
      "observability": { "enabled": false },
      "secrets": { "required": ["CLERK_JWT_KEY", "CLERK_SECRET_KEY", "UNSUBSCRIBE_SIGNING_KEY"] },
      "assets": {
        "directory": "../frontend/dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fan-director-staging",
          "database_id": "5411bfbd-0b73-49f4-b866-30d26076fe9b",
          "migrations_dir": "migrations"
        }
      ],
      // Creator uploads (migration 0005). Private bucket: its public development
      // URL stays off, and images are only served through GET /api/media/:id,
      // which checks the uploading creator is still active.
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "fan-director-media-staging" }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        // STILL THE OLD HOST, deliberately: the studiolens.me zone does not
        // exist yet, and pointing this at a hostname that does not resolve
        // would send every visitor of the working staging site nowhere.
        // This is step 2 of the cutover noted above — one line.
        "APP_ORIGIN": "https://fan-director-studio-staging.blendly.workers.dev",
        "CLERK_ISSUER": "https://superb-crawdad-9550.clerk.accounts.dev",
        // Both hosts during the cutover; drop the workers.dev entry once the
        // domain has been live long enough that no old session is still going.
        // An origin nothing can be served from yet is inert: `azp` is only ever
        // compared for equality (src/auth.ts), never matched by suffix.
        "CLERK_AUTHORIZED_PARTIES": "https://fan-director-studio-staging.blendly.workers.dev,https://www.studiolens.me",
        // Phase 3: the owner OK'd the AI Director on staging (2026-09-18). Adult stays off.
        "AI_ENABLED": "true",
        "ADULT_CATALOG_ENABLED": "false",
        // Owner's waiver (doc 11 §5.6 item 27, 2026-09-20; widened 2026-09-21).
        // It began while Clerk MFA waited on revenue; the owner has extended it
        // to cover the first few PAYING creators, to get the business moving,
        // with MFA required retroactively later. A creator signs in with their
        // email alone, so whoever can read that mailbox can approve commissions.
        // The enforcement code is untouched: flipping this to "true" turns the
        // queue into "set up an authenticator, then reload" for anyone who has
        // not enrolled. Tell creators before flipping it, not after.
        "CREATOR_SECOND_FACTOR_REQUIRED": "false",
        // Phase 3 (doc 11 §5.6 item 24): $3 of the owner's $8 test budget; the rest is for local live runs.
        "AI_BUDGET_CEILING_MICROUSD": "3000000",
        "AI_RAW_RETENTION_DAYS": "30"
      },
      // Daily clean-up of raw AI conversation text (src/ai/retention.ts).
      "triggers": { "crons": ["17 3 * * *"] }
    }
  }
}
