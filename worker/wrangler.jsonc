// Phase 1 staging Worker (doc 11 §7). It serves the built frontend as static
// assets and runs the API under /api/*. The public demo keeps its own config in
// frontend/wrangler.jsonc and is not touched by this file.
//
// The top level is local development. `--env staging` is the only deployable
// environment. Database ids are placeholders until the owner provisions them;
// scripts/staging-guard.mjs refuses to deploy while they are.
// Secrets (never in this file): CLERK_JWT_KEY, CLERK_SECRET_KEY, UNSUBSCRIBE_SIGNING_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fan-director-studio-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  // Unsubscribe tokens travel in URLs; keep request logs off.
  "observability": { "enabled": false },
  "secrets": { "required": ["CLERK_JWT_KEY", "CLERK_SECRET_KEY", "UNSUBSCRIBE_SIGNING_KEY"] },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fan-director-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "CLERK_ISSUER": "https://superb-crawdad-9550.clerk.accounts.dev",
    "CLERK_AUTHORIZED_PARTIES": "http://localhost:8787,http://localhost:5173",
    "AI_ENABLED": "false",
    "ADULT_CATALOG_ENABLED": "false"
  },
  "env": {
    "staging": {
      "name": "fan-director-studio-staging",
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": false },
      "secrets": { "required": ["CLERK_JWT_KEY", "CLERK_SECRET_KEY", "UNSUBSCRIBE_SIGNING_KEY"] },
      "assets": {
        "directory": "../frontend/dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fan-director-staging",
          "database_id": "5411bfbd-0b73-49f4-b866-30d26076fe9b",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://fan-director-studio-staging.blendly.workers.dev",
        "CLERK_ISSUER": "https://superb-crawdad-9550.clerk.accounts.dev",
        "CLERK_AUTHORIZED_PARTIES": "https://fan-director-studio-staging.blendly.workers.dev",
        "AI_ENABLED": "false",
        "ADULT_CATALOG_ENABLED": "false"
      }
    }
  }
}
