{
  "name": "fan-director-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "node scripts/staging-guard.mjs && wrangler deploy --env staging"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.11",
    "@cloudflare/workers-types": "^5.20260917.1",
    "typescript": "~6.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.132.0"
  }
}
