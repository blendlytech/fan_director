// Hosted demo: static assets only, no Worker script, no bindings, no backend.
// `npm run build` writes dist/; unknown paths serve index.html so deep links
// such as /creator/requests/:id/ask load directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fan-director-studio",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
